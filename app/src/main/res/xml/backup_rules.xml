<?xml version="1.0" encoding="utf-8"?>
<!--
   Used before Android 12 if backups were ever turned on: nothing is included, so no login
   session or other app data can be restored. allowBackup="false" in the manifest disables it.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
